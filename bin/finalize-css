#!/usr/bin/env ruby
require 'yaml'
require_relative 'site_tools'

root = File.expand_path('..', __dir__)
config = YAML.load_file(File.join(root, '_config.yml'))
SiteTools.fingerprint_css(File.join(root, '_site'), config.fetch('url'), config['baseurl'].to_s)
puts 'Versioned CSS using the final generated bytes.'
